# OmniAssist AI — Frontend environment variables (copy to .env.local)

# Public app config
NEXT_PUBLIC_APP_NAME=OmniAssist AI
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend API (FastAPI) — used in Phase 4 wiring
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Supabase (client)
NEXT_PUBLIC_SUPABASE_URL=<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

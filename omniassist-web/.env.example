# OmniAssist Health — Frontend environment variables (copy to .env.local)

# Public app config
NEXT_PUBLIC_APP_NAME=OmniAssist Health
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend API (FastAPI) — bare origin only; the app appends the /api/v1 prefix.
# Note: local dev uses port 8001 (a Django/daphne server squats on 8000).
NEXT_PUBLIC_API_URL=http://localhost:8001

# Supabase (client)
NEXT_PUBLIC_SUPABASE_URL=<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

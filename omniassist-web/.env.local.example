# OmniAssist AI — web env
#
# Base URL of the omniassist-api backend. When set, the app fetches live data and
# uses real authentication. When UNSET, the app runs in demo mode on local mock
# data (no backend required) — copy this file to .env.local to go live.
#
# Local dev:   NEXT_PUBLIC_API_URL=http://localhost:8000
# Production:  NEXT_PUBLIC_API_URL=https://api.omniassist.ai
NEXT_PUBLIC_API_URL=

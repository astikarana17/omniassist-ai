# ===== OmniAssist AI Backend — Environment =====
# Copy to .env and fill in. NEVER commit real secrets.

# --- App ---
ENVIRONMENT=development            # development | staging | production
DEBUG=true
APP_NAME=OmniAssist AI
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
SECRET_KEY=change-me-to-a-long-random-string
LOG_LEVEL=INFO

# --- Database (Supabase PostgreSQL) ---
# Use the connection pooler URL for serverless; async driver = postgresql+asyncpg
DATABASE_URL=postgresql+asyncpg://postgres:password@db.<your-project-ref>.supabase.co:5432/postgres
# Sync URL for Alembic migrations
DATABASE_SYNC_URL=postgresql+psycopg2://postgres:password@db.<your-project-ref>.supabase.co:5432/postgres
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- JWT ---
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Encryption (Fernet key for at-rest secret encryption) ---
ENCRYPTION_KEY=generate-with-Fernet.generate_key

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- Anthropic / Claude ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8
CLAUDE_FAST_MODEL=claude-haiku-4-5-20251001
CLAUDE_MAX_TOKENS=2048

# --- Pinecone ---
PINECONE_API_KEY=
PINECONE_INDEX=omniassist-kb
PINECONE_HOST=<your-index>.svc.<region>.pinecone.io
EMBEDDING_DIM=1024

# --- Twilio ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_VOICE_NUMBER=+14155238886

# --- Gmail / SMTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=support@omniassist.ai

# --- Slack ---
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=#support

# --- Observability ---
SENTRY_DSN=

# --- Storage (Supabase Storage / S3-compatible) ---
STORAGE_BUCKET=omniassist-uploads
MAX_UPLOAD_MB=25
